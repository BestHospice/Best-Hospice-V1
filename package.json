    "@sendgrid/mail": "^8.1.1",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "fast-xml-parser": "^5.5.7",
    "google-ads-api": "^23.0.0",
    "googleapis": "^171.4.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.2.1",
    "stripe": "^20.1.2",
    "twilio": "^4.23.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  }
}
