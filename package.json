{
  "name": "best-hospice",
  "version": "1.0.0",
  "description": "Best Hospice site with simple provider API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "prisma:migrate:dev": "node scripts/prisma-migrate-dev.js",
    "prisma:status": "prisma migrate status",
    "prisma:generate": "prisma generate",
    "generate:static-seo": "node scripts/generate-static-seo-pages.js",
    "cms:identity:import": "node scripts/import-cms-hospice-identities.js",
    "cms:hospice:import": "node scripts/import-cms-hospice-data.js",
    "postinstall": "prisma generate --schema prisma/schema.prisma",
    "test:seo": "node scripts/test-seo-templates.js",
    "test:seo:live": "node scripts/test-seo-templates.js --live https://www.besthospice.com",
    "test:cms:importer": "node scripts/test-cms-identity-importer.js",
    "test:cms:archive": "node scripts/test-cms-archive.js",
    "test:cms:datalayer": "node scripts/test-cms-data-layer.js",
    "test:cms:ingestion": "node scripts/test-cms-hospice-ingestion.js",
    "test:provider:internal-role": "node scripts/test-provider-internal-role.js",
    "test:cms:resolver": "node scripts/test-cms-provider-resolver.js"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.79.0",
    "@prisma/client": "^5.22.0",
    "@sendgrid/mail": "^8.1.1",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "fast-xml-parser": "^5.5.7",
    "google-ads-api": "^23.0.0",
    "googleapis": "^171.4.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.2.1",
    "stripe": "^20.1.2",
    "twilio": "^4.23.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  }
}
