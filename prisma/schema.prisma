generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model Provider {
  id              String   @id @default(uuid())
  name            String
  email           String
  providerLoginEmail String?
  phone           String?
  website         String?
  address         String
  city            String
  state           String
  zip             String
  lat             Float
  lon             Float
  serviceRadiusKm Float
  featured        Boolean  @default(false)
  planTier        String   @default("verified")
  careType        String   @default("hospice")
  leadCount       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  notifications   LeadNotification[]
  impressions     ProviderImpression[]
  users           ProviderUserProvider[]
  activeUsers     ProviderUser[] @relation("ActiveProvider")
}

model Lead {
  id            String   @id @default(uuid())
  zip           String
  submittedBy   String
  careDays      String?
  careTimes     String?
  services      String?
  clientEmail   String?
  clientPhone   String?
  firstName     String?
  lastName      String?
  createdAt     DateTime @default(now())

  notifications LeadNotification[]
  impressions   ProviderImpression[]
}

model LeadNotification {
  id                 String                 @id @default(uuid())
  lead               Lead                   @relation(fields: [leadId], references: [id])
  leadId             String
  provider           Provider               @relation(fields: [providerId], references: [id])
  providerId         String
  status             String
  sendgridMessageId  String?
  errorMessage       String?
  sentAt             DateTime?
  createdAt          DateTime               @default(now())
}

model NotificationJob {
  id         String   @id @default(uuid())
  leadId     String
  providerId String
  runAt      DateTime
  status     String   @default("pending")
  attempts   Int      @default(0)
  lastError  String?
  lockedAt   DateTime?
  payload    Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status, runAt])
  @@index([lockedAt])
  @@index([providerId])
  @@index([leadId])
}

model ProviderImpression {
  id         String   @id @default(uuid())
  provider   Provider @relation(fields: [providerId], references: [id])
  providerId String
  lead       Lead?    @relation(fields: [leadId], references: [id])
  leadId     String?
  zip        String
  createdAt  DateTime @default(now())
}

model BlogPost {
  id          String      @id @default(uuid())
  title       String
  body        String
  authorEmail String
  authorCity  String
  authorState String
  createdAt   DateTime    @default(now())
  comments    BlogComment[]
}

model BlogComment {
  id          String   @id @default(uuid())
  post        BlogPost @relation(fields: [postId], references: [id])
  postId      String
  body        String
  authorEmail String
  authorCity  String
  authorState String
  createdAt   DateTime @default(now())
}

model BlogEmailVerification {
  id          String   @id @default(uuid())
  email       String
  city        String
  state       String
  code        String
  expiresAt   DateTime
  verifiedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([email, code])
  @@index([email, verifiedAt])
}

model AdminAuditLog {
  id              String     @id @default(uuid())
  adminIdentifier String
  action          String
  targetType      String
  targetId        String?
  metadataJson    String?
  ipHash          String?
  createdAt       DateTime   @default(now())
}

model RateLimitEvent {
  id        String   @id @default(uuid())
  ipHash    String
  createdAt DateTime @default(now())
}

model ProviderUser {
  id                   String    @id @default(uuid())
  email                String    @unique
  passwordHash         String
  emailVerifiedAt      DateTime?
  verifyCode           String?
  verifyCodeExpiresAt  DateTime?
  activeProvider       Provider? @relation("ActiveProvider", fields: [activeProviderId], references: [id])
  activeProviderId     String?
  links                ProviderUserProvider[]
  createdAt            DateTime  @default(now())
}

model ProviderUserProvider {
  id             String   @id @default(uuid())
  providerUser   ProviderUser @relation(fields: [providerUserId], references: [id])
  providerUserId String
  provider       Provider @relation(fields: [providerId], references: [id])
  providerId     String
  createdAt      DateTime @default(now())

  @@unique([providerUserId, providerId])
}
