generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model Provider {
  id                       String                     @id @default(uuid())
  name                     String
  email                    String
  phone                    String?
  website                  String?
  address                  String
  city                     String
  state                    String
  zip                      String
  lat                      Float
  lon                      Float
  serviceRadiusKm          Float
  featured                 Boolean                    @default(false)
  leadCount                Int                        @default(0)
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  planTier                 String                     @default("verified")
  providerLoginEmail       String?
  careType                 String                     @default("hospice")
  secondaryContactEmail    String?
  serviceZipCodes          String?
  activelyHiring           Boolean                    @default(true)
  receiveClientLeads       Boolean                    @default(true)
  receiveJobLeads          Boolean                    @default(true)
  stripeCustomerId         String?
  stripeSubscriptionId     String?
  subscriptionStatus       String?
  currentPeriodEnd         DateTime?                  @db.Timestamp(6)
  billingMode              String                     @default("free")
  subscriptionMonthlyCents Int?
  /// Marks a provider record kept for internal operational or reference
  /// purposes rather than as a real participating provider. NULL for every real
  /// provider, which is why no backfill is needed.
  ///
  /// A string rather than a boolean so future internal account types need no new
  /// column. First and currently only value: "cms_reference" - the account used
  /// to exercise the CMS provider-facing pipeline end to end.
  ///
  /// INVARIANT: any provider with a non-null internalRole is excluded from every
  /// public and business behaviour - client leads, job leads, the directory,
  /// location pages, the sitemap, its own public detail page, JSON-LD and
  /// billing - while KEEPING authenticated dashboard access, which is the whole
  /// point of the account. See isInternalProvider() in server.js.
  ///
  /// This is deliberately NOT expressed through ProviderExternalIdentity, which
  /// stays authoritative identity data meaning "this provider IS that external
  /// provider". An identity row must never be created merely to borrow another
  /// organisation's CMS data for testing.
  internalRole             String?
  notifications            LeadNotification[]
  outcomes                 LeadOutcome[]
  impressions              ProviderImpression[]
  activeUsers              ProviderUser[]             @relation("ActiveProvider")
  externalIdentities       ProviderExternalIdentity[]
  users                    ProviderUserProvider[]
}

model Lead {
  id               String               @id @default(uuid())
  zip              String
  submittedBy      String
  careDays         String?
  careTimes        String?
  services         String?
  clientEmail      String?
  clientPhone      String?
  firstName        String?
  lastName         String?
  createdAt        DateTime             @default(now())
  sessionId        String?
  adminStatus      String?
  adminProviderId  String?
  gclid            String?
  fbclid           String?
  firstChannel     String?
  firstSource      String?
  firstMedium      String?
  firstCampaign    String?
  firstTerm        String?
  firstContent     String?
  firstLandingPage String?
  firstReferrer    String?
  firstTouchAt     DateTime?            @db.Timestamptz(6)
  lastChannel      String?
  lastSource       String?
  lastMedium       String?
  lastCampaign     String?
  lastTerm         String?
  lastContent      String?
  lastLandingPage  String?
  lastReferrer     String?
  lastTouchAt      DateTime?            @db.Timestamptz(6)
  notifications    LeadNotification[]
  outcomes         LeadOutcome[]
  impressions      ProviderImpression[]

  @@index([firstChannel], map: "idx_lead_first_channel")
  @@index([sessionId], map: "idx_lead_session_id")
}

model LeadNotification {
  id                String    @id @default(uuid())
  leadId            String
  providerId        String
  status            String
  sendgridMessageId String?
  errorMessage      String?
  sentAt            DateTime?
  createdAt         DateTime  @default(now())
  lead              Lead      @relation(fields: [leadId], references: [id])
  provider          Provider  @relation(fields: [providerId], references: [id])
}

model LeadOutcome {
  id                  String             @id @default(uuid())
  leadId              String
  providerId          String
  status              String             @default("new")
  firstResponseAt     DateTime?
  lastStatusChangedAt DateTime           @default(now())
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  lead                Lead               @relation(fields: [leadId], references: [id])
  provider            Provider           @relation(fields: [providerId], references: [id])
  events              LeadOutcomeEvent[]

  @@unique([leadId, providerId])
  @@index([providerId, status])
  @@index([leadId])
}

model LeadOutcomeEvent {
  id            String      @id @default(uuid())
  leadOutcomeId String
  fromStatus    String?
  toStatus      String
  changedBy     String      @default("provider")
  changedAt     DateTime    @default(now())
  leadOutcome   LeadOutcome @relation(fields: [leadOutcomeId], references: [id])

  @@index([leadOutcomeId, changedAt])
}

model NotificationJob {
  id         String    @id @default(uuid())
  leadId     String
  providerId String
  runAt      DateTime
  status     String    @default("pending")
  attempts   Int       @default(0)
  lastError  String?
  lockedAt   DateTime?
  payload    Json
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status, runAt])
  @@index([lockedAt])
  @@index([providerId])
  @@index([leadId])
}

model ProviderImpression {
  id         String   @id @default(uuid())
  providerId String
  leadId     String?
  zip        String
  createdAt  DateTime @default(now())
  lead       Lead?    @relation(fields: [leadId], references: [id])
  provider   Provider @relation(fields: [providerId], references: [id])
}

model BlogPost {
  id          String        @id @default(uuid())
  title       String
  body        String
  authorEmail String
  authorCity  String
  authorState String
  createdAt   DateTime      @default(now())
  comments    BlogComment[]
}

model BlogComment {
  id          String   @id @default(uuid())
  postId      String
  body        String
  authorEmail String
  authorCity  String
  authorState String
  createdAt   DateTime @default(now())
  post        BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model BlogEmailVerification {
  id         String    @id @default(uuid())
  email      String
  city       String
  state      String
  code       String
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, code])
  @@index([email, verifiedAt])
}

model AdminAuditLog {
  id              String   @id @default(uuid())
  adminIdentifier String
  action          String
  targetType      String
  targetId        String?
  metadataJson    String?
  ipHash          String?
  createdAt       DateTime @default(now())
}

model RateLimitEvent {
  id        String   @id @default(uuid())
  ipHash    String
  createdAt DateTime @default(now())
}

model ProviderUser {
  id                  String                 @id @default(uuid())
  email               String                 @unique
  passwordHash        String
  emailVerifiedAt     DateTime?
  createdAt           DateTime               @default(now())
  verifyCode          String?
  verifyCodeExpiresAt DateTime?
  activeProviderId    String?
  activeProvider      Provider?              @relation("ActiveProvider", fields: [activeProviderId], references: [id])
  links               ProviderUserProvider[]
}

model ProviderUserProvider {
  id             String       @id @default(uuid())
  providerUserId String
  providerId     String
  createdAt      DateTime     @default(now())
  provider       Provider     @relation(fields: [providerId], references: [id])
  providerUser   ProviderUser @relation(fields: [providerUserId], references: [id])

  @@unique([providerUserId, providerId])
}

/// Accepted identity mapping between a Best Hospice Provider and an external
/// authoritative source. A row existing means the mapping has been accepted —
/// this is not a review queue. Candidates, competing matches, rejections,
/// evidence and match methods stay in the CMS candidate report until a
/// dedicated review model exists.
///
/// Provider deletes are Restrict by omission, matching every other relation to
/// Provider. Cascade would silently discard human verification work.
model ProviderExternalIdentity {
  id             String    @id @default(uuid())
  providerId     String
  /// External registry or dataset, e.g. "cms_hospice".
  source         String
  /// The identifier as the source publishes it. String because CMS CCNs carry
  /// leading zeros and are not all numeric.
  externalId     String
  /// Which identifier externalId is, e.g. "ccn". Null means the source's
  /// canonical identifier.
  identifierType String?
  /// Match score 0-1 from the candidate generator. Null when entered by hand.
  confidence     Float?
  verifiedAt     DateTime?
  /// Free-text admin identifier; there is no admin user model to reference.
  verifiedBy     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  provider Provider @relation(fields: [providerId], references: [id])

  @@unique([source, externalId])
  @@index([providerId])
  @@index([source])
}

/// One ingested CMS dataset-family release. Everything loaded from CMS points at
/// the release it came from, so database state is always traceable to specific
/// archived bytes.
///
/// `source` uses the EXTERNAL IDENTITY namespace ("cms_hospice",
/// "cms_home_health"), not the archive-family names ("hospice", "home-health").
/// The archive pipeline translates via sources[] in data/cms-dataset-registry.json.
/// See docs/cms-data-pipeline.md.
///
/// Per-file detail (sourceUrl, per-dataset sha256, row counts, headers) stays in
/// the archive manifest. Only the release-level facts that database rows depend
/// on are duplicated here.
model CmsRelease {
  id             String   @id @default(uuid())
  /// "cms_hospice" | "cms_home_health"
  source         String
  /// Max `modified` date across the datasets resolved for this family in ONE
  /// archive capture. Derived by scripts/cms-archive.js releaseKeyOf():
  /// max(modified) over the non-skipped datasets. It is an ARCHIVE-CAPTURE
  /// identifier, not a single CMS dataset's release date - home-health
  /// "2026-06-10" contains four datasets modified 2026-05-27 and one modified
  /// 2026-06-10.
  releaseKey     String
  /// When the archive captured this release (manifest.capturedAt).
  capturedAt     DateTime
  /// When this release was loaded into the database.
  ingestedAt     DateTime @default(now())
  /// Datasets present in the archived release.
  datasetCount   Int
  /// sha256 over the RAW BYTES of the release's manifest.json exactly as the
  /// archiver wrote it - not canonicalised JSON. That manifest carries
  /// `sha256Raw` for every dataset file in the release, so this single value
  /// transitively pins every archived byte behind this row.
  manifestSha256 String?

  facilitiesFirstSeen   CmsFacility[]            @relation("CmsFacilityFirstSeen")
  facilitiesLastSeen    CmsFacility[]            @relation("CmsFacilityLastSeen")
  serviceAreasFirstSeen CmsFacilityServiceArea[] @relation("CmsServiceAreaFirstSeen")
  serviceAreasLastSeen  CmsFacilityServiceArea[] @relation("CmsServiceAreaLastSeen")
  facilityMeasures      CmsFacilityMeasure[]
  facilityObservations  CmsFacilityObservation[]

  @@unique([source, releaseKey])
  /// Target for the composite foreign keys below. Guarantees a facility or
  /// service area can only reference a release of its OWN source.
  @@unique([id, source])
}

/// One CMS-certified facility, independent of whether it is a Best Hospice
/// Provider. The national universe is the point: most of these rows are
/// competitors, not customers.
///
/// Current-state only. This row is updated in place as CMS republishes, with
/// firstSeenRelease / lastSeenRelease bracketing observation. Per-release
/// snapshots of changing attributes are deferred to a future CmsFacilityHistory,
/// and quality measures to a future CmsMeasure. Neither exists yet.
///
/// (source, ccn) is the natural key and is deliberately shaped to match
/// ProviderExternalIdentity (source, externalId). That join is LOGICAL only -
/// there is no foreign key between them, because an accepted identity must not
/// depend on whether CMS data has been ingested. See docs/cms-data-pipeline.md.
model CmsFacility {
  id     String @id @default(uuid())
  /// "cms_hospice" | "cms_home_health"
  source String
  /// CMS Certification Number, exactly as published. String, never numeric:
  /// 24% of hospice CCNs are alphanumeric (A01500) and thousands carry leading
  /// zeros in both families.
  ccn    String

  /// 100% populated in both families.
  name    String
  address String
  city    String
  state   String
  /// 5-character string. Leading zeros are significant.
  zip     String

  /// Hospice publishes County/Parish; the home-health file has no county column.
  county            String?
  /// Formats differ by family - hospice "(602) 855-3500", home health "6028553500".
  /// Stored verbatim; normalisation is an ingestion concern, not a storage one.
  phone             String?
  /// Vocabularies differ by family - hospice "For-Profit", home health
  /// "PROPRIETARY". Stored verbatim; no cross-family mapping is implied.
  ownershipType     String?
  /// CMS publishes MM/DD/YYYY, date-only, so this is @db.Date rather than a
  /// timestamp: there is no time component to invent and no timezone to get
  /// wrong. Null where CMS wrote a blank or "-" sentinel.
  certificationDate DateTime? @db.Date

  firstSeenReleaseId String
  lastSeenReleaseId  String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  /// Restrict by omission, as everywhere else in this schema: deleting a release
  /// must never erase the facilities observed in it.
  firstSeenRelease CmsRelease               @relation("CmsFacilityFirstSeen", fields: [firstSeenReleaseId, source], references: [id, source])
  lastSeenRelease  CmsRelease               @relation("CmsFacilityLastSeen", fields: [lastSeenReleaseId, source], references: [id, source])
  serviceAreas     CmsFacilityServiceArea[]
  measures         CmsFacilityMeasure[]
  observations     CmsFacilityObservation[]

  @@unique([source, ccn])
  /// Target for CmsFacilityServiceArea's composite foreign key.
  @@unique([id, source])
  @@index([source, state])
  @@index([source, zip])
  @@index([firstSeenReleaseId])
  @@index([lastSeenReleaseId])
}

/// A ZIP code CMS reports this facility as serving. ~915k rows at current
/// national scale (hospice ~350k, home health ~566k).
///
/// Answers "which facilities serve ZIP X" (the competitor-overlap query) and
/// "which ZIPs does facility Y serve".
model CmsFacilityServiceArea {
  id         String @id @default(uuid())
  facilityId String
  /// Denormalised from the facility on purpose. It is what makes the composite
  /// foreign keys below possible, so the database guarantees this row, its
  /// facility and its releases all belong to one source. It also lets the hot
  /// competitor-overlap query hit (source, zip) without joining CmsFacility.
  source     String
  /// 5-character string. Leading zeros are significant.
  zip        String

  firstSeenReleaseId String
  lastSeenReleaseId  String
  createdAt          DateTime @default(now())

  facility         CmsFacility @relation(fields: [facilityId, source], references: [id, source])
  firstSeenRelease CmsRelease  @relation("CmsServiceAreaFirstSeen", fields: [firstSeenReleaseId, source], references: [id, source])
  lastSeenRelease  CmsRelease  @relation("CmsServiceAreaLastSeen", fields: [lastSeenReleaseId, source], references: [id, source])

  @@unique([facilityId, zip])
  /// The competitor-overlap query: "which facilities of this kind serve ZIP X".
  /// Always source-scoped in practice - hospices are compared with hospices.
  @@index([source, zip])
  @@index([lastSeenReleaseId])
}

/// What CMS published about one facility in one release. APPEND-ONLY HISTORY.
///
/// WHY THIS EXISTS
/// CmsFacility is current state: its ON CONFLICT clause overwrites name, address,
/// city, state, zip, county, phone, ownershipType and certificationDate on every
/// ingest, so the previous release's values are destroyed. Measured on the two
/// archived hospice releases (2026-05-01 -> 2026-08-19), a single 3.5-month
/// interval changed ownershipType for 1,310 of 6,610 shared facilities, name for
/// 220 and address for 982. None of that was recoverable from the database.
///
/// PRESENCE IS ROW EXISTENCE, NOT A FLAG. A facility observed in a release has a
/// row for it; one absent from that release has none. That is what makes a GAP
/// representable - present in R1, absent in R2, present again in R3 - which
/// CmsFacility's single firstSeen/lastSeen interval structurally cannot express.
///
/// RAW VALUES ONLY. Everything here is stored exactly as CMS published it, with
/// the same parsing the current-state upsert uses (NA sentinels -> null,
/// MM/DD/YYYY -> date, Address Line 1 + 2 joined). Interpretation belongs to
/// future intelligence, not to storage. Two measured consequences future
/// consumers MUST handle:
///   - `county` must be compared CASE-INSENSITIVELY. CMS changed its casing
///     convention wholesale between the two releases ("Maricopa" -> "MARICOPA"),
///     which is 6,490 of 6,553 observed county changes. Raw equality would
///     manufacture thousands of false alerts.
///   - `ownershipType` value -> null is a CMS COVERAGE REGRESSION, not an
///     ownership change. 788 of 1,310 observed transitions were value -> null;
///     only 522 were value -> value. Null is preserved exactly as published.
///
/// A NEW RELEASE NEVER UPDATES AN OLDER ROW: releaseId is part of the natural
/// key, so a later release inserts a new row and leaves prior rows untouched.
/// This is the same shape CmsFacilityMeasure already uses, and it is what makes
/// a future history-only backfill of an older release safe - appending rows for
/// an earlier releaseId cannot mutate current state.
model CmsFacilityObservation {
  id String @id @default(uuid())

  facilityId String
  /// Denormalised from the facility, exactly as on CmsFacilityServiceArea and
  /// CmsFacilityMeasure. It is what makes both composite foreign keys below
  /// possible, so the database guarantees an observation, its facility and its
  /// release all belong to one source.
  source     String
  releaseId  String
  /// Denormalised as published. Preserves the identifier CMS actually printed if
  /// a CCN is ever reassigned to a different organisation - the case the
  /// current-state row cannot record, because it would silently overwrite one
  /// organisation's attributes with another's under the same (source, ccn) key.
  ccn        String

  name              String
  address           String
  city              String
  state             String
  zip               String
  county            String?
  phone             String?
  ownershipType     String?
  /// Date-only for the same reason as CmsFacility.certificationDate: CMS
  /// publishes MM/DD/YYYY and there is no time component to invent.
  certificationDate DateTime? @db.Date

  createdAt DateTime @default(now())

  facility CmsFacility @relation(fields: [facilityId, source], references: [id, source])
  release  CmsRelease  @relation(fields: [releaseId, source], references: [id, source])

  /// One observation per facility per release. This is the rerun-safety key: an
  /// idempotent re-ingest of the same release rewrites the same row rather than
  /// adding a second one, and the database - not importer logic - is what
  /// prevents duplicates.
  ///
  /// It also serves as the "this facility over time" index, so a separate
  /// @@index([facilityId, releaseId]) is deliberately NOT declared: it would be
  /// a second btree over identical columns.
  @@unique([facilityId, releaseId])
  /// "Everything CMS published in release R" - the release-scoped scan behind
  /// any future release-over-release diff.
  @@index([source, releaseId])
  /// Ownership mix within one release, without reading every column.
  @@index([source, releaseId, ownershipType])
}

/// The measure dictionary for Quality Intelligence. One row per CMS measure code
/// we surface, seeded from data/cms-hospice-quality-measures.json by
/// scripts/import-cms-hospice-quality.js.
///
/// THIS TABLE IS WHERE DIRECTIONALITY LIVES. `direction` says whether a higher or
/// a lower published value is better care, it is sourced from CMS Hospice Quality
/// Reporting Program documentation rather than from the data, and every comparison
/// in cms-hospice-quality.js reads it from here. Nothing infers direction at query
/// or render time, so a measure can never be silently compared the wrong way round.
///
/// CMS also publishes an H_012_xx_PERCENTILE for each Hospice Care Index indicator.
/// It is a plain monotone rank of the RAW value with no directional correction
/// (Spearman rho = 1.0000 against the observed value on all ten indicators), so on
/// a lower-is-better indicator a higher CMS percentile means WORSE care. It is
/// deliberately not modelled and must never be surfaced as a quality rank.
model CmsMeasureDefinition {
  id          String @id @default(uuid())
  /// "cms_hospice" | "cms_home_health". Same namespace as CmsFacility.source.
  source      String
  /// The CMS measure code exactly as published, e.g. "H_012_00_OBSERVED".
  measureCode String

  /// CMS's own Measure Name for this code, recorded as a FACT at ingestion time.
  /// Ingestion fails closed if the archived file disagrees, which is how a CMS
  /// measure redefinition surfaces as an error instead of a silent relabelling.
  cmsMeasureName String
  /// Best Hospice's provider-facing label. Ours, not CMS's.
  shortLabel     String
  /// Groups measures into one provider-facing dimension, e.g. "liveDischarge"
  /// carries both the early and the late live-discharge measures.
  dimension      String
  /// "hci" | "hci_indicator" | "his" | "hvldl" | "cahps"
  family         String
  /// "index" | "percent" | "stars"
  valueKind      String
  /// "higher_better" | "lower_better". No other value is written today; a
  /// contextual measure would need explicit product handling, not a third enum
  /// value that comparison code silently ignores.
  direction      String

  scaleMin  Float?
  scaleMax  Float?
  decimals  Int
  unitLabel String?

  /// The companion CMS code carrying this measure's sample size, e.g.
  /// "H_012_02_DENOMINATOR". Its value is stored on the measurement row's
  /// `denominator` column rather than as a measurement of its own.
  denominatorCode String?
  /// Whether Quality Intelligence V1 shows this measure to providers.
  surfaced        Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  measurements CmsFacilityMeasure[]

  @@unique([source, measureCode])
  /// Target for CmsFacilityMeasure's composite foreign key.
  @@unique([id, source])
  @@index([source, surfaced])
}

/// One CMS-published measurement: a facility, a measure, a release.
///
/// Unlike CmsFacility and CmsFacilityServiceArea, which are CURRENT STATE updated
/// in place, this table is a per-release SNAPSHOT - releaseId is part of the
/// natural key. Measures carry their own measurement period and CMS republishes
/// them on a different cadence from the facility roster, so overwriting the
/// previous period's value in place would destroy the only record of it.
///
/// SUPPRESSION IS FIRST CLASS. CMS withholds a measure for small samples and other
/// documented reasons, and a withheld measure is NOT a zero, NOT an average and NOT
/// a low score. `valueNumeric` is null in that case, `valueRaw` keeps the exact CMS
/// text ("Not Available", "Not Applicable"), `suppressed` is true, and the peer
/// comparison in cms-hospice-quality.js excludes the row from every denominator.
model CmsFacilityMeasure {
  id String @id @default(uuid())

  facilityId  String
  /// Denormalised from the facility, exactly as on CmsFacilityServiceArea. It is
  /// what makes all three composite foreign keys below possible, so the database
  /// guarantees a measurement, its facility, its measure definition and its
  /// release all belong to one source.
  source      String
  /// References CmsMeasureDefinition, so an undefined measure code cannot be
  /// stored at all - unknown codes are refused by the database, not just by the
  /// ingester.
  measureCode String
  releaseId   String

  /// The parsed number, or NULL when CMS published no usable value. Float, not
  /// Decimal: every surfaced measure is a percentage, a 0-10 index or a 1-5 star
  /// rating with at most one published decimal place, and nothing is summed into
  /// money.
  valueNumeric  Float?
  /// The Score (or Star Rating) cell verbatim, so a suppressed row still records
  /// exactly what CMS said. Never trimmed to "" and never replaced with "0".
  valueRaw      String
  /// True whenever CMS published no comparable observation. Explicit rather than
  /// inferred from `valueNumeric IS NULL` so the intent survives in the data.
  suppressed    Boolean
  /// CMS footnote codes for this cell. An ARRAY because CMS publishes multi-valued
  /// footnotes such as "2,5" and "6,7"; storing that as an integer would corrupt it.
  /// Empty array when CMS wrote its no-footnote sentinel ("-" or blank).
  footnoteCodes String[]
  /// Sample size from the measure's companion denominator code, where CMS
  /// publishes one. Null is "not published", never "zero patients".
  denominator   Float?
  /// CAHPS publishes its summary rating in a separate Star Rating column rather
  /// than in Score. Null for every non-CAHPS measure.
  starRating    Int?

  /// The measurement period CMS published for this cell. Date-only, so @db.Date:
  /// there is no time component to invent. Stored PER MEASUREMENT because the
  /// periods genuinely differ within one release - in the 2026-08-19 archive the
  /// HCI measures cover 01/01/2023-12/31/2024, the composite process measure
  /// 10/01/2024-09/30/2025 and CAHPS 10/01/2023-09/30/2025.
  periodStart DateTime? @db.Date
  periodEnd   DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  facility   CmsFacility          @relation(fields: [facilityId, source], references: [id, source])
  release    CmsRelease           @relation(fields: [releaseId, source], references: [id, source])
  definition CmsMeasureDefinition @relation(fields: [source, measureCode], references: [source, measureCode])

  /// One measurement per facility, measure and release. Includes releaseId on
  /// purpose: this is history, not current state.
  @@unique([facilityId, measureCode, releaseId])
  /// The market-comparison index. The peer query asks for ONE measure, in ONE
  /// release, across a set of facilities, which is exactly this column order.
  @@index([source, releaseId, measureCode, facilityId])
  /// "everything this facility published in this release" - the provider's own
  /// side of the comparison.
  @@index([facilityId, releaseId])
  @@index([releaseId])
}

model WaitlistRequest {
  id           String   @id @default(uuid())
  zip          String
  contactEmail String?
  contactPhone String?
  timeline     String?
  createdAt    DateTime @default(now())
}

model JobLead {
  id                  String   @id @default(uuid())
  zip                 String
  name                String?
  email               String?
  phone               String?
  role                String?
  licensed            String?
  availability        String?
  timeline            String?
  experience          String?
  openToMultiple      String?
  notifiedProviderIds String?
  createdAt           DateTime @default(now())
}

model DischargeReferral {
  id           String   @id
  plannerName  String?  @map("planner_name")
  plannerTitle String?  @map("planner_title")
  plannerEmail String?  @map("planner_email")
  plannerPhone String?  @map("planner_phone")
  facility     String?
  patientFirst String?  @map("patient_first")
  patientLast  String?  @map("patient_last")
  patientZip   String?  @map("patient_zip")
  careType     String?  @map("care_type")
  urgency      String?
  insurance    String?
  notes        String?
  status       String   @default("new")
  source       String   @default("discharge_planner")
  submittedAt  DateTime @default(now()) @map("submitted_at")
}

model Testimonial {
  id           String    @id
  quote        String
  authorName   String    @map("author_name")
  authorTitle  String?   @map("author_title")
  active       Boolean   @default(true)
  displayOrder Int       @default(0) @map("display_order")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  status       String    @default("approved")
  providerId   String?   @map("provider_id")
  reviewedAt   DateTime? @map("reviewed_at") @db.Timestamptz(6)
}

model NewsletterIssue {
  id          String   @id
  issueNumber Int      @map("issue_number")
  slug        String   @unique(map: "idx_newsletter_issues_slug")
  subject     String
  preview     String?
  webHtml     String?  @map("web_html")
  sentCount   Int      @default(0) @map("sent_count")
  failedCount Int      @default(0) @map("failed_count")
  sentAt      DateTime @default(now()) @map("sent_at") @db.Timestamptz(6)

  @@map("newsletter_issues")
}

model NewsletterSubscriber {
  id        String   @id
  name      String
  email     String   @unique
  source    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([email], map: "idx_newsletter_subscribers_email")
  @@map("newsletter_subscribers")
}

model WebsiteEvent {
  id           String   @id
  viewerId     String   @map("viewer_id")
  sessionId    String   @map("session_id")
  eventType    String   @map("event_type")
  path         String
  referrer     String?
  durationMs   Int?     @map("duration_ms")
  scrollDepth  Int?     @map("scroll_depth")
  eventValue   String?  @map("event_value")
  metadataJson String?  @map("metadata_json")
  userAgent    String?  @map("user_agent")
  ipHash       String?  @map("ip_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt], map: "idx_website_events_created_at")
  @@index([eventType], map: "idx_website_events_event_type")
  @@index([sessionId], map: "idx_website_events_session_id")
  @@index([viewerId], map: "idx_website_events_viewer_id")
  @@map("website_events")
}
